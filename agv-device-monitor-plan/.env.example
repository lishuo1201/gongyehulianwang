# Local placeholders: 复制为.env并填入本机专用凭据，不将真实值提交Git。
MYSQL_DATABASE=agv_monitor
MYSQL_USER=replace_with_local_app_user
MYSQL_PASSWORD=replace_with_local_random_password
MYSQL_ROOT_PASSWORD=replace_with_different_root_password
AGV_HTTP_PORT=8080
# Optional dev ports: 仅在加载compose.dev.yaml时发布，始终绑定回环地址。
AGV_MYSQL_PORT=3307
AGV_SIM_HTTP_PORT=8081
AGV_MODBUS_PORT=1502
